    {"id":"TLA-REFERENCE","revision":"r2-local","source":"code","group":"REVIEW","risk":"low","scope_kind":"whole",
      "scope":{"input":"tlaplus","unit":"document","context":"none","related":[{"role":"operands","input":"tlaplus-operands","unit":"document","on":[],"allow_empty":false}]},
