      "applicability":{"include":["*"],"exclude":[]},"falsifier":"An unrelated definition, comment or reference under another connective supplies a positive conjunct.","fixtures":{"pass":[{"path":"tla-conjunct-negative.json","corpus_revision":"r1","source_sha256":"c73eb1c1439f399791544ed3cab61bcc32ad38dbe13bc71752010966d211f417","evidence_sha256":"c73eb1c1439f399791544ed3cab61bcc32ad38dbe13bc71752010966d211f417"}],"fail":[{"path":"tla-conjunct-positive.json","corpus_revision":"r1","source_sha256":"879720923aa8b5e916184ff11406bf3881516c7d8f84d7bd8c9527ab5f403091","evidence_sha256":"879720923aa8b5e916184ff11406bf3881516c7d8f84d7bd8c9527ab5f403091"}]}},
    {"id":"PY-PATH-SYNTAX","revision":"r1-local","source":"code","group":"REVIEW","risk":"low","scope_kind":"whole",
      "scope":{"input":"python","unit":"document","context":"none"},
      "title":"One direct returned open call and its same-function identifiers","evidence":"source","evaluator":{"kind":"syntax","contract":"syntax/1"},
      "check":{"kind":"syntax/1","language":"python","json_string_pointer":"/subject","query":"((function_definition parameters: (parameters (identifier) @parameter) body: (block (return_statement (call function: (identifier) @callee arguments: (argument_list . (identifier) @argument))))) (#eq? @callee \"open\"))\n((function_definition parameters: (parameters (identifier) @parameter) body: (block (return_statement (call function: (attribute object: (call function: (identifier) @callee arguments: (argument_list . (identifier) @argument))))))) (#eq? @callee \"open\"))","limits":{"captures":3}},
      "applicability":{"include":["*"],"exclude":[]},"falsifier":"A capture comes from another function or argument, or ambiguous candidates appear complete.","fixtures":{"pass":[],"fail":[]}},
    {"id":"PY-PATH","revision":"r2-local","source":"code","group":"REVIEW","risk":"low","scope_kind":"whole",
      "scope":{"input":"python","unit":"document","context":"none"},
      "title":"First open argument identifier has the same spelling as its function parameter","evidence":"source","evaluator":{"kind":"json-pointer-compare","contract":"json-pointer-compare/1"},
      "consult":{"rules":["PY-PATH-SYNTAX"]},
      "check":{"kind":"json-pointer-compare/1","left":"/prior/0/observation/fields/captures/0/text","right":"/prior/0/observation/fields/captures/2/text","fail_when":"equal"},
      "applicability":{"include":["*"],"exclude":[]},"falsifier":"The same-function parameter identifier and first open argument identifier are compared incorrectly; equal spelling establishes neither unchanged value nor runtime name binding.","fixtures":{"pass":[{"path":"python-identifiers-different.json","corpus_revision":"r1","source_sha256":"9e9ca79567c33b51758f3bd58685ec81d7d021db80b5a191de42aa965817c939","evidence_sha256":"9e9ca79567c33b51758f3bd58685ec81d7d021db80b5a191de42aa965817c939"}],"fail":[{"path":"python-identifiers-equal.json","corpus_revision":"r1","source_sha256":"dd6e98f99125607e0798f186828fe6d3ba23215d9844acf784753dac75986f63","evidence_sha256":"dd6e98f99125607e0798f186828fe6d3ba23215d9844acf784753dac75986f63"}]}}
