{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AudiToad question set",
  "description":"Questions and declared context for baseline review. Question IDs must be unique. AudiToad also refuses duplicate JSON object keys.",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","id","questions"],
  "properties":{
    "schema":{"const":"auditoad-question-set/1"},
    "id":{"$ref":"#/$defs/text"},
    "declared_context":{},
    "questions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/question"}}
  },
  "$defs":{
    "text":{"type":"string","minLength":1,"pattern":"\\S"},
    "question":{
      "type":"object",
      "additionalProperties":false,
      "required":["id","instructions"],
      "properties":{
        "id":{"$ref":"#/$defs/text"},
        "instructions":{"$ref":"#/$defs/text"},
        "criteria_true":{"$ref":"#/$defs/text"},
        "criteria_false":{"$ref":"#/$defs/text"},
        "options":{"type":"object","minProperties":2,
          "propertyNames":{"$ref":"#/$defs/text"},
          "additionalProperties":{"$ref":"#/$defs/text"}},
        "declared_context":{}
      },
      "dependentRequired":{"criteria_true":["criteria_false"],"criteria_false":["criteria_true"]},
      "allOf":[
        {"not":{"required":["options","criteria_true"]}},
        {"not":{"required":["options","criteria_false"]}}
      ]
    }
  }
}
