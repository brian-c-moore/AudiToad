{
  "$schema":"../../docs/baseline.schema.json",
  "schema":"auditoad-baseline/1",
  "baseline":{"id":"language-helpers","version":"2","title":"Syntax evidence for six languages","publisher":"AudiToad examples","status":"draft"},
  "sources":{"code":{"adapter":"collection/1","media":["application/vnd.auditoad.collection+json"]}},
  "evidence":{"source":{"builder":"scoped-input/1","builder_revision":"r1"}},
  "groups":[{"id":"SYNTAX","title":"Source syntax"},{"id":"REVIEW","title":"Questions using syntax evidence"}],
  "rules":[
    {"id":"BASH","revision":"r1","source":"code","group":"SYNTAX","risk":"low","scope_kind":"whole",
      "scope":{"input":"bash","unit":"document","context":"none"},
      "title":"Bash command syntax","evidence":"source","evaluator":{"kind":"syntax","contract":"syntax/1"},
      "check":{"kind":"syntax/1","language":"bash","json_string_pointer":"/subject","query":"(command name: (command_name) @callee) @call"},
      "applicability":{"include":["*"],"exclude":[]},"falsifier":"A captured span differs from the supplied source or a refused parse appears complete.","fixtures":{"pass":[],"fail":[]}},
    {"id":"ZSH","revision":"r1","source":"code","group":"SYNTAX","risk":"low","scope_kind":"whole",
      "scope":{"input":"zsh","unit":"document","context":"none"},
      "title":"Zsh command syntax","evidence":"source","evaluator":{"kind":"syntax","contract":"syntax/1"},
      "check":{"kind":"syntax/1","language":"zsh","json_string_pointer":"/subject","query":"(command name: (command_name) @callee) @call"},
      "applicability":{"include":["*"],"exclude":[]},"falsifier":"A captured span differs from the supplied source or a refused parse appears complete.","fixtures":{"pass":[],"fail":[]}},
    {"id":"POWERSHELL","revision":"r1","source":"code","group":"SYNTAX","risk":"low","scope_kind":"whole",
      "scope":{"input":"powershell","unit":"document","context":"none"},
      "title":"PowerShell command syntax","evidence":"source","evaluator":{"kind":"syntax","contract":"syntax/1"},
      "check":{"kind":"syntax/1","language":"powershell","json_string_pointer":"/subject","query":"(command command_name: (command_name) @callee) @call"},
      "applicability":{"include":["*"],"exclude":[]},"falsifier":"A captured span differs from the supplied source or a refused parse appears complete.","fixtures":{"pass":[],"fail":[]}},
    {"id":"PYTHON","revision":"r1","source":"code","group":"SYNTAX","risk":"low","scope_kind":"whole",
      "scope":{"input":"python","unit":"document","context":"none"},
      "title":"Python direct-call syntax","evidence":"source","evaluator":{"kind":"syntax","contract":"syntax/1"},
      "check":{"kind":"syntax/1","language":"python","json_string_pointer":"/subject","query":"(call function: (identifier) @callee) @call"},
      "applicability":{"include":["*"],"exclude":[]},"falsifier":"A captured span differs from the supplied source or a refused parse appears complete.","fixtures":{"pass":[],"fail":[]}},
    {"id":"RUST","revision":"r1","source":"code","group":"SYNTAX","risk":"low","scope_kind":"whole",
      "scope":{"input":"rust","unit":"document","context":"none"},
      "title":"Rust direct-call syntax","evidence":"source","evaluator":{"kind":"syntax","contract":"syntax/1"},
      "check":{"kind":"syntax/1","language":"rust","json_string_pointer":"/subject","query":"(call_expression function: (identifier) @callee) @call"},
      "applicability":{"include":["*"],"exclude":[]},"falsifier":"A captured span differs from the supplied source or a refused parse appears complete.","fixtures":{"pass":[],"fail":[]}},
    {"id":"TLAPLUS","revision":"r1","source":"code","group":"SYNTAX","risk":"low","scope_kind":"whole",
      "scope":{"input":"tlaplus","unit":"document","context":"none"},
      "title":"TLA+ operator definitions","evidence":"source","evaluator":{"kind":"syntax","contract":"syntax/1"},
      "check":{"kind":"syntax/1","language":"tlaplus","json_string_pointer":"/subject","query":"(operator_definition name: (identifier) @name definition: (_) @definition)"},
      "applicability":{"include":["*"],"exclude":[]},"falsifier":"A comment becomes a definition or an alias is claimed to have been semantically resolved.","fixtures":{"pass":[],"fail":[]}},
    {"id":"TLA-REFERENCE","revision":"r1","source":"code","group":"REVIEW","risk":"low","scope_kind":"whole",
      "scope":{"input":"tlaplus","unit":"document","context":"none"},
      "title":"Direct reference in the displayed Spec definition","evidence":"source","evaluator":{"kind":"model","contract":"yes-no/1"},
      "consult":{"rules":["TLAPLUS"]},
      "check":{"kind":"yes-no/1","instructions":"Does the displayed definition of Spec directly refer to the operator Progress? This asks about that definition's source text, not whether a temporal property holds.",
        "criteria_true":"Spec directly references Progress.","criteria_false":"Spec does not directly reference Progress.",
        "pass_below":0.1,"fail_at_or_above":0.9,"max_request_bytes":null,
        "state_projection":{"source":"/subject","captures":"/prior/0/observation/fields/captures","syntax_identity":"/prior/0/observation/selected_sha256"}},
      "applicability":{"include":["*"],"exclude":[]},"falsifier":"An unrelated definition or comment supplies the alleged reference.","fixtures":{"pass":[],"fail":[]}},
    {"id":"PY-PATH","revision":"r1","source":"code","group":"REVIEW","risk":"low","scope_kind":"whole",
      "scope":{"input":"python","unit":"document","context":"none"},
      "title":"Caller-supplied path at the displayed open call","evidence":"source","evaluator":{"kind":"model","contract":"yes-no/1"},
      "consult":{"rules":["PYTHON"]},
      "check":{"kind":"yes-no/1","instructions":"At the displayed direct call spelled open, is its first argument the enclosing function's path parameter, without transformation? Judge only this local source relationship. The syntax helper does not resolve which runtime function open names.",
        "criteria_true":"The first argument is that unchanged parameter.","criteria_false":"The first argument is not that unchanged parameter.",
        "pass_below":0.1,"fail_at_or_above":0.9,"max_request_bytes":null,
        "state_projection":{"source":"/subject","captures":"/prior/0/observation/fields/captures","syntax_identity":"/prior/0/observation/selected_sha256"}},
      "applicability":{"include":["*"],"exclude":[]},"falsifier":"The question misidentifies the displayed argument's local relationship to the parameter.","fixtures":{"pass":[],"fail":[]}}
  ],
  "profiles":[
    {"id":"syntax","select":["SYNTAX/*"],"block_on":["fail","review","error","not_evaluated"],"allowed_egress":[]},
    {"id":"review","select":["PY-PATH"],"block_on":["fail","review","error","not_evaluated"],"allowed_egress":["https://api.typesafe.ai","loopback"]},
    {"id":"formal","select":["TLA-REFERENCE"],"block_on":["fail","review","error","not_evaluated"],"allowed_egress":["https://api.typesafe.ai","loopback"]}
  ],
  "default_profile":"syntax"
}
