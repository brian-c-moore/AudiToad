{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AudiToad input collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "inputs"],
  "properties": {
    "schema": {"const": "auditoad-collection/1"},
    "inputs": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"type": "string", "pattern": "\\S"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["adapter"],
        "properties": {
          "adapter": {"enum": ["text/1", "json/1", "json-lines/1"]},
          "path": {"type": "string", "minLength": 1},
          "unavailable": {"type": "string", "pattern": "\\S"}
        },
        "oneOf": [{"required": ["path"], "not": {"required": ["unavailable"]}},
                  {"required": ["unavailable"], "not": {"required": ["path"]}}]
      }
    }
  }
}
